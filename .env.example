# Copy this file to `.env` and fill in the values.

# --- Server-side secrets (never exposed to the client) ---
# GROQ_API_KEY: PRIMARY model provider (Groq llama-3.3-70b-versatile, free
# ~30 req/min, reachable from Vercel's serverless egress unlike NIM).
# Get one free (no card) at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# NVIDIA_API_KEY: Second hop (NVIDIA NIM, free ~40 req/min). NOTE: NVIDIA's
# edge drops chat POSTs from Vercel egress (works fine from local dev), which
# is why Groq leads the chain. Get one free (no card) at https://build.nvidia.com
NVIDIA_API_KEY="your_nvidia_nim_api_key_here"

# GEMINI_API_KEY: FALLBACK model provider (free tier ~20 req/day) when NIM's
# rate limit is hit. Server-side only.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ELEVENLABS_API_KEY: Jarvis's premium voice (/api/tts). Free tier ~10k
# credits/month; the app uses eleven_flash_v2_5 at 0.5 credits/char. When the
# quota runs out the app silently falls back to browser TTS.
# Get one at https://elevenlabs.io (Profile -> API keys)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# TAVILY_API_KEY: Live web search for Jarvis (/api/search). Free tier
# 1000 searches/month, no card. Get one at https://tavily.com
TAVILY_API_KEY="your_tavily_api_key_here"

# KITE_API_KEY / KITE_API_SECRET: Zerodha Kite Connect (read-only portfolio).
# Create an app at https://developers.kite.trade with Redirect URL:
#   https://ascend-delta-sage.vercel.app/api/kite/callback
# The secret is used ONLY for the server-side token exchange.
KITE_API_KEY="your_kite_api_key_here"
KITE_API_SECRET="your_kite_api_secret_here"

# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / TELEGRAM_WEBHOOK_SECRET: two-way
# texting with Jarvis from your phone, no browser or Electron app needed.
#   1. Message @BotFather on Telegram, /newbot, get a token.
#   2. Message your new bot once, then visit
#      https://api.telegram.org/bot<token>/getUpdates and read
#      result[0].message.chat.id -> TELEGRAM_CHAT_ID. Only this chat is ever
#      answered; every other chat is silently ignored.
#   3. TELEGRAM_WEBHOOK_SECRET: any random string you pick.
#   4. After deploying, register the webhook once:
#      curl "https://api.telegram.org/bot<token>/setWebhook?url=https://<your-domain>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_own_numeric_telegram_chat_id"
TELEGRAM_WEBHOOK_SECRET="pick_any_random_string"
# ASCEND_UID: your Firebase Auth uid (console -> Authentication -> Users ->
# "User UID" column). The Telegram webhook has no login step, so this is how
# it knows whose Arena/reminders data to read.
ASCEND_UID="your_firebase_uid_here"
# FIREBASE_SERVICE_ACCOUNT: required for Telegram specifically (admin-db.ts) —
# see server-log.ts's own setup comment for how to generate it.
FIREBASE_SERVICE_ACCOUNT=""

# PORT: Optional. Local server port (defaults to 3000).
# PORT=3000

# --- Firebase web config (OPTIONAL) ---
# These are PUBLIC values (safe in the client bundle); access is enforced by
# Firestore Security Rules, not by hiding them. If omitted, the app falls back
# to firebase-applet-config.json. Set them to target a different Firebase
# project per environment (e.g. separate prod/dev projects on Vercel).
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""

# --- Google OAuth (client-side GIS token flow) ---
# VITE_GOOGLE_CLIENT_ID: OAuth Web client ID powering Google Calendar sync and
# the Gmail module. PUBLIC value (client IDs are not secrets). Setup steps:
# see GOOGLE_SETUP.md.
# VITE_GOOGLE_CLIENT_ID=""

# --- Google OAuth (server-side code flow — powers Telegram calendar alerts) ---
# Lets telegram-cron.ts read Calendar with no browser open, unlike the client
# flow above which dies when the tab closes. Reuses VITE_GOOGLE_CLIENT_ID as
# the client id if GOOGLE_CLIENT_ID isn't set separately. Setup: GOOGLE_SETUP.md.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET="your_oauth_client_secret_here"
# GOOGLE_OAUTH_REDIRECT_URI="https://<your-domain>/api/google-oauth/callback"
