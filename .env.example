# Copy this file to `.env` and fill in the values.

# --- Server-side secrets (never exposed to the client) ---
# GROQ_API_KEY: PRIMARY model provider (Groq llama-3.3-70b-versatile, free
# ~30 req/min, reachable from Vercel's serverless egress unlike NIM).
# Get one free (no card) at https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# NVIDIA_API_KEY: Second hop (NVIDIA NIM, free ~40 req/min). NOTE: NVIDIA's
# edge drops chat POSTs from Vercel egress (works fine from local dev), which
# is why Groq leads the chain. Get one free (no card) at https://build.nvidia.com
NVIDIA_API_KEY="your_nvidia_nim_api_key_here"

# GEMINI_API_KEY: FALLBACK model provider (free tier ~20 req/day) when NIM's
# rate limit is hit. Server-side only.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ELEVENLABS_API_KEY: Jarvis's premium voice (/api/tts). Free tier ~10k
# credits/month; the app uses eleven_flash_v2_5 at 0.5 credits/char. When the
# quota runs out the app silently falls back to browser TTS.
# Get one at https://elevenlabs.io (Profile -> API keys)
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# TAVILY_API_KEY: Live web search for Jarvis (/api/search). Free tier
# 1000 searches/month, no card. Get one at https://tavily.com
TAVILY_API_KEY="your_tavily_api_key_here"

# KITE_API_KEY / KITE_API_SECRET: Zerodha Kite Connect (read-only portfolio).
# Create an app at https://developers.kite.trade with Redirect URL:
#   https://ascend-delta-sage.vercel.app/api/kite/callback
# The secret is used ONLY for the server-side token exchange.
KITE_API_KEY="your_kite_api_key_here"
KITE_API_SECRET="your_kite_api_secret_here"

# PORT: Optional. Local server port (defaults to 3000).
# PORT=3000

# --- Firebase web config (OPTIONAL) ---
# These are PUBLIC values (safe in the client bundle); access is enforced by
# Firestore Security Rules, not by hiding them. If omitted, the app falls back
# to firebase-applet-config.json. Set them to target a different Firebase
# project per environment (e.g. separate prod/dev projects on Vercel).
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""

# --- Google OAuth (client-side GIS token flow) ---
# VITE_GOOGLE_CLIENT_ID: OAuth Web client ID powering Google Calendar sync and
# the Gmail module. PUBLIC value (client IDs are not secrets). Setup steps:
# see GOOGLE_SETUP.md.
# VITE_GOOGLE_CLIENT_ID=""
